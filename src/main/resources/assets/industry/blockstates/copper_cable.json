    { "when": { "down": "true" }, "apply": { "model": "industry:block/copper_cable_arm", "x": 180 } },
    { "when": { "north": "true" }, "apply": { "model": "industry:block/copper_cable_arm", "x": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "industry:block/copper_cable_arm", "x": 90, "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "industry:block/copper_cable_arm", "x": 90, "y": 270 } },
    { "when": { "east": "true" }, "apply": { "model": "industry:block/copper_cable_arm", "x": 90, "y": 90 } }
  ]
